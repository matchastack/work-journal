# Every setting the backend reads. Copy to .env for local development.
# Names only: never put real values, and never commit .env.
# An empty value means "use the default".

# Runtime environment: development (default), test or production.
APP_ENV=

# Log level: DEBUG, INFO (default), WARNING or ERROR.
LOG_LEVEL=

# PostgreSQL URL (secret in production). For local development with compose.yml:
# postgresql+asyncpg://work_journal@localhost:5432/work_journal
DATABASE_URL=

# Keys that encrypt journal and fact text (secret): id:key pairs, the current key first.
# `uv run wj keys new` makes one. Keep old keys after the new one until `wj keys rotate` has run.
DATA_ENCRYPTION_KEY=

# Claude API key (secret). Without it, the Anthropic SDK looks for its other credentials.
ANTHROPIC_API_KEY=

# Model ID for each tier (requirements §10). A tier without a model can't be called.
LLM_MODEL_HEAVY=
LLM_MODEL_STANDARD=
LLM_MODEL_LIGHT=

# USD per million input and output tokens for each tier, as JSON: [input, output].
# Without a price, calls are still logged, but without a cost.
LLM_PRICE_HEAVY=
LLM_PRICE_STANDARD=
LLM_PRICE_LIGHT=

# Rerun a refused heavy-tier request on the API's recommended fallback model: true (default) or false.
LLM_HEAVY_FALLBACK=

# JSONL file that logs every LLM call (default: local/llm-calls.jsonl, which git ignores).
LLM_CALL_LOG=
