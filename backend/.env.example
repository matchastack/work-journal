# Every setting the backend reads. Copy to .env for local development.
# Names only: never put real values, and never commit .env.
# An empty value means "use the default".

# Runtime environment: development (default), test or production.
APP_ENV=

# Log level: DEBUG, INFO (default), WARNING or ERROR.
LOG_LEVEL=

# PostgreSQL URL (secret in production). For local development with compose.yml:
# postgresql+asyncpg://work_journal@localhost:5432/work_journal
DATABASE_URL=

# Keys that encrypt journal and fact text (secret): id:key pairs, the current key first.
# `uv run wj keys new` makes one. Keep old keys after the new one until `wj keys rotate` has run.
DATA_ENCRYPTION_KEY=

# The app's public address, e.g. https://journal.example.com (default: http://localhost:8000).
# It must use https://, except on this computer (localhost).
APP_URL=

# Sign-in with GitHub: an OAuth app (github.com/settings/developers) whose callback URL is
# <APP_URL>/auth/callback. The client secret is a secret.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub usernames that may sign in, separated by commas. Empty (the default): nobody can.
ALLOWED_GITHUB_LOGINS=

# Claude API key (secret). Without it, the Anthropic SDK looks for its other credentials.
ANTHROPIC_API_KEY=

# Model ID for each tier (requirements §10). A tier without a model can't be called.
LLM_MODEL_HEAVY=
LLM_MODEL_STANDARD=
LLM_MODEL_LIGHT=

# USD per million input and output tokens for each tier, as JSON: [input, output].
# Without a price, calls are still logged, but without a cost.
LLM_PRICE_HEAVY=
LLM_PRICE_STANDARD=
LLM_PRICE_LIGHT=

# Rerun a refused heavy-tier request on the API's recommended fallback model: true (default) or false.
LLM_HEAVY_FALLBACK=

# JSONL file where the command line logs every LLM call (default: local/llm-calls.jsonl, which
# git ignores). The app logs calls to the llm_calls table.
LLM_CALL_LOG=

# Telegram bot (requirements §7.1). The token comes from @BotFather. The webhook secret is any
# random string of 1 to 256 letters, digits, _ and -, for example from `openssl rand -hex 32`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Minutes of quiet after which a journal entry closes (default 30).
ENTRY_TIMEOUT_MINUTES=

# A random secret of at least 16 characters for /internal/tick, which Vercel's cron calls once a
# day to run background jobs (requirements §13). Vercel sends it as `Authorization: Bearer <secret>`.
CRON_SECRET=

# The built web app, served at / (default: frontend/dist in this repository).
WEB_DIST_DIR=
