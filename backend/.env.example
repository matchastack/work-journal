# Every setting the backend reads. Copy to .env for local development.
# Names only: never put real values, and never commit .env.
# An empty value means "use the default".

# Runtime environment: development (default), test or production.
APP_ENV=

# Log level: DEBUG, INFO (default), WARNING or ERROR.
LOG_LEVEL=

# PostgreSQL URL (secret in production). For local development with compose.yml:
# postgresql+asyncpg://work_journal@localhost:5432/work_journal
DATABASE_URL=

# The app's public address, e.g. https://journal.example.com (default: http://localhost:8000).
APP_URL=

# Sign-in with GitHub: an OAuth app (github.com/settings/developers) whose callback URL is
# <APP_URL>/auth/callback. The client secret is a secret.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub usernames that may sign in, separated by commas. Empty (the default): nobody can.
ALLOWED_GITHUB_LOGINS=

# The built web app, served at / (default: frontend/dist in this repository).
WEB_DIST_DIR=
